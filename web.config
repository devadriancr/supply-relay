<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS + HttpPlatformHandler: IIS starts uvicorn and forwards every request to it.
    Change C:\inetpub\supply-relay to the folder where the project lives.
    Download HttpPlatformHandler: https://www.iis.net/downloads/microsoft/httpplatformhandler
-->
<configuration>
    <system.webServer>
        <handlers>
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>
        <httpPlatform processPath="C:\inetpub\supply-relay\.venv\Scripts\python.exe"
                      arguments="-m uvicorn relay.web:create_app --factory --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --proxy-headers --forwarded-allow-ips 127.0.0.1"
                      startupTimeLimit="60"
                      processesPerApplication="1"
                      stdoutLogEnabled="true"
                      stdoutLogFile="C:\inetpub\supply-relay\logs\uvicorn">
            <environmentVariables>
                <environmentVariable name="PYTHONUNBUFFERED" value="1" />
            </environmentVariables>
        </httpPlatform>

        <security>
            <requestFiltering removeServerHeader="true">
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".venv" />
                    <add segment="data" />
                    <add segment="logs" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
