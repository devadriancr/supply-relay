# Infor LX (IBM i) via ODBC. Use a READ-ONLY user, never LXSECOFR.
INFOR_DSN="Driver={iSeries Access ODBC Driver};System=192.168.200.7;"
INFOR_USERNAME=
INFOR_PASSWORD=
INFOR_LIBRARY=LX834F01
INFOR_CUSTOM_LIBRARY=LX834FU01

# Supplier portal (Laravel) that receives the data
PORTAL_URL=https://proveedores.example.com
# Same value as SYNC_KEY in the portal .env, at least 32 characters:
# python -c "import secrets; print(secrets.token_hex(32))"
SYNC_KEY=
PORTAL_VERIFY_TLS=true

# Work calendar (FSC). Orders and DI are sent from the 1st of the previous month
CALENDAR_FACILITY=YK1
CALENDAR_WORK_CENTER=0

# Admin screen
ADMIN_USERNAME=admin
# Generate with: .venv\Scripts\python.exe -m relay.passwd
ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# false only while testing without HTTPS
SECURE_COOKIES=true
